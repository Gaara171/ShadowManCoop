// Versionsangaben der Mod-DLL (Datei-Eigenschaften -> Details). Unbekannte DLLs ohne diese Angaben stufen manche
// Virenscanner eher als verdaechtig ein. Version hier und in release\nexus\nexus_page.txt gleich halten.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,9,1,0
 PRODUCTVERSION 0,9,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Gaara"
            VALUE "FileDescription", "Shadow Man Co-op mod (SMCoop) - loads with Shadow Man Remastered"
            VALUE "FileVersion", "0.9.1-beta"
            VALUE "InternalName", "SMCoop"
            VALUE "LegalCopyright", "(c) 2026 Gaara - unofficial fan mod"
            VALUE "OriginalFilename", "xaudio2_9redist.dll"
            VALUE "ProductName", "Shadow Man Co-op BETA"
            VALUE "ProductVersion", "0.9.1-beta"
            VALUE "Comments", "Co-op multiplayer mod. Forwards all XAudio2 calls to the original xaudio2_9redist_orig.dll."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
